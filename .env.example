# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3002
API_PREFIX=/api

# ─── Database ─────────────────────────────────────────────────────────────────
# Local Docker Compose default — matches docker-compose.yml's postgres service
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/delivery_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate strong random secrets, e.g.: openssl rand -hex 64
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Stripe ───────────────────────────────────────────────────────────────────
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# ─── Google Maps ──────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ─── Email (Nodemailer) ───────────────────────────────────────────────────────
# Local dev: https://mailtrap.io sandbox inbox works well here
SMTP_HOST=your_smtp_host_here
SMTP_PORT=2525
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here
EMAIL_FROM=noreply@example.com

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─── Logs ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=logs
